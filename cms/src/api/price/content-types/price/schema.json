{
  "kind": "collectionType",
  "collectionName": "prices",
  "info": {
    "singularName": "price",
    "pluralName": "prices",
    "displayName": "price",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "price"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "RUB"
      ],
      "required": true,
      "default": "RUB"
    },
    "direction": {
      "type": "enumeration",
      "enum": [
        "FORM",
        "CURRENT",
        "UPTO"
      ],
      "default": "FORM",
      "required": true
    }
  }
}
