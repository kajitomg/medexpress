{
  "kind": "collectionType",
  "collectionName": "prices",
  "info": {
    "singularName": "price",
    "pluralName": "prices",
    "displayName": "price",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "price"
    },
    "price": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "priceStatus"
            },
            "AVAILABLE"
          ]
        }
      },
      "required": true
    },
    "direction": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "priceStatus"
            },
            "AVAILABLE"
          ]
        }
      },
      "required": true,
      "default": "FROM",
      "enum": [
        "FROM",
        "CURRENT"
      ]
    },
    "currency": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency.currency",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "priceStatus"
            },
            "AVAILABLE"
          ]
        }
      }
    },
    "priceStatus": {
      "type": "enumeration",
      "required": true,
      "default": "AVAILABLE",
      "enum": [
        "AVAILABLE",
        "NOT SPECIFIED",
        "ON REQUEST"
      ]
    }
  }
}
